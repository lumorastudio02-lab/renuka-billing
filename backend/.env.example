# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://localhost:27017/renuka_billing_db

# Authentication & Security
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=super_secret_enterprise_jwt_key_renuka_paramedical_2026
JWT_REFRESH_SECRET=super_secret_enterprise_jwt_refresh_key_2026
